@model IEnumerable<StudentManagementSystem.Models.Instructor>

@{
    ViewData["Title"] = "Instructors Directory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Instructors Directory</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Instructor
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Photo</th>
                        <th>Instructor Name</th>
                        <th>Department</th>
                        <th>Assigned Advisees</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No instructors found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-user.png" : item.ImageUrl)"
                                         alt="@item.Name"
                                         class="rounded-circle border"
                                         width="45"
                                         height="45"
                                         style="object-fit: cover;" />
                                </td>
                                <td class="fw-bold">@item.Name</td>
                                <td><span class="badge bg-secondary">@item.Major</span></td>
                                <td>
                                    <span class="badge bg-info text-dark fs-6 fw-normal">
                                        <i class="bi bi-people-fill me-1"></i> @item.Students.Count Students
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View Advisees
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>