



@model StudentManagementSystem.Models.PaginatedList<StudentManagementSystem.Models.Student>

<table class="table table-hover table-striped mb-0 align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Photo</th>
            <th>
                <a href="javascript:void(0);"
                   class="text-white text-decoration-none sort-link"
                   data-sort="@ViewData["NameSortParm"]">
                    Full Name ↕
                </a>
            </th>
            <th>Email</th>
            <th>Department</th>
            <th>
                <a href="javascript:void(0);"
                   class="text-white text-decoration-none sort-link"
                   data-sort="@ViewData["DateSortParm"]">
                    Enrollment Date ↕
                </a>
            </th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center py-4 text-muted">
                    No student records found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var student in Model)
            {
                <tr>
                    <!-- 1. ID -->
                    <td>@student.Id</td>

                    <!-- 2. Photo -->
                    <td class="text-center">
                        <img src="@(string.IsNullOrEmpty(student.ProfilePicturePath) ? "/images/default-avatar.svg" : student.ProfilePicturePath)"
                             alt="@student.FirstName @student.LastName"
                             class="rounded-circle"
                             style="width: 40px; height: 40px; object-fit: cover; border: 1px solid #dee2e6;" />
                    </td>

                    <!-- 3. Full Name -->
                    <td>@student.FirstName @student.LastName</td>

                    <!-- 4. Email -->
                    <td>@student.Email</td>

                    <!-- 5. Department -->
                    <td>@student.Major</td>

                    <!-- 6. Enrollment Date -->
                    <td>@student.EnrollmentDate.ToString("MMM dd, yyyy")</td>

                    <!-- 7. Status Badge -->
                    <td>
                        <partial name="_StudentStatusBadge" model="student.EnrollmentDate" />
                    </td>


                    <!-- 8. Actions -->
                    <td>
                        <button class="btn btn-sm btn-outline-warning btn-edit me-1" data-id="@student.Id">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger btn-delete" data-id="@student.Id">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- Pagination Controls -->
<div class="d-flex justify-content-between align-items-center p-3 bg-light border-top">
    <small class="text-muted">
        Showing Page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount Total Students)
    </small>

    <nav aria-label="Table navigation">
        <ul class="pagination pagination-sm mb-0">
            <!-- Previous Button -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link page-change" href="javascript:void(0);" data-page="@(Model.PageIndex - 1)">Previous</a>
            </li>

            <!-- Page Number Links -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link page-change" href="javascript:void(0);" data-page="@i">@i</a>
                </li>
            }

            <!-- Next Button -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link page-change" href="javascript:void(0);" data-page="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>