@model StudentManagementSystem.Models.Student

<form id="editStudentForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="EditId" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" id="EditFirstName" required />
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" id="EditLastName" required />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" id="EditEmail" required />
    </div>

    <div class="mb-3">
        <label asp-for="Major" class="form-label"></label>
        <input asp-for="Major" class="form-control" id="EditMajor" required />
    </div>

    <div class="mb-3">
        <label asp-for="EnrollmentDate" class="form-label"></label>
        <input asp-for="EnrollmentDate" type="date" class="form-control" id="EditEnrollmentDate"
               value="@Model.EnrollmentDate.ToString("yyyy-MM-dd")" required />
    </div>

    <div class="modal-footer px-0 pb-0 pt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" id="btnUpdateStudent" class="btn btn-warning">Update Student</button>
    </div>
</form>