@model StudentManagementSystem.Models.PaginatedList<StudentManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Student List";
    var selectedDept = ViewData["SelectedDepartment"] as string;
    var selectedStatus = ViewData["StatusFilter"] as string;
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- Title -->
        <h2 class="mb-0">Student Management System</h2>

        <!-- Right Action Buttons Group -->
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Student" asp-action="ExportPdf" target="_blank" class="btn btn-outline-danger">
                <i class="bi bi-file-earmark-pdf me-1"></i> Export to PDF
            </a>

            <button type="button" class="btn btn-primary" id="btnOpenCreateModal">
                <i class="bi bi-plus-circle me-1"></i> Add New Student
            </button>
        </div>
    </div>

    
    
    <!-- Multi-Criteria Search & Filter Toolbar -->
    <form id="searchForm" class="card card-body bg-light mb-4 shadow-sm border-0">
        <div class="row g-2 align-items-center">
            <!-- 1. Text Search Input -->
            <div class="col-md-4">
                <label class="form-label text-muted fw-bold small mb-1">Search Keywords</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text"
                           id="searchInput"
                           name="searchString"
                           class="form-control"
                           placeholder="Name or Email..."
                           value="@ViewData["CurrentFilter"]" />
                </div>
            </div>

            <!-- 2. Department Filter Dropdown -->
            <div class="col-md-3">
                <label class="form-label text-muted fw-bold small mb-1">Department</label>
                <select id="departmentFilter" name="selectedDepartment" class="form-select">
                    <option value="">All Departments</option>
                    @if (ViewData["Departments"] is List<string> departments)
                    {
                        foreach (var dept in departments)
                        {
                            <option value="@dept" selected="@(dept == selectedDept ? "selected" : null)">@dept</option>
                        }
                    }
                </select>
            </div>

            <!-- 3. Status Filter Dropdown -->
            <div class="col-md-3">
                <label class="form-label text-muted fw-bold small mb-1">Enrollment Status</label>
                <select id="statusFilter" name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(selectedStatus == "Active" ? "selected" : null)">Active</option>
                    <option value="Graduated" selected="@(selectedStatus == "Graduated" ? "selected" : null)">Graduated</option>
                </select>
            </div>

            

            <!-- 4. Action Buttons -->
            <div class="col-md-2 d-flex align-items-end gap-1 pt-4">
                <button type="button" id="btnReset" class="btn btn-outline-success w-100" title="Reset Filters">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>
            </div>
        </div>
    </form>


    <!-- Student Table Card -->
    <div class="card shadow-sm">
        <!-- Render partial view on initial load so layout matches AJAX re-renders -->
        <div class="card-body p-0" id="tableContainer">
            @await Html.PartialAsync("_StudentTablePartial", Model)
        </div>
    </div>

</div> 

<!-- Hidden Anti-Forgery Token for AJAX Header Reading -->
@Html.AntiForgeryToken() 

 <!-- Bootstrap Modal Shell -->
<div class="modal fade" id="studentModal" tabindex="-1" aria-labelledby="studentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="studentModalLabel">Student Information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Partial views (_CreatePartial / _EditPartial) render here -->
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // State tracking across AJAX refreshes
        var currentPage = 1;
        var currentSort = "@(ViewData["CurrentSort"] ?? "")";

        $(document).ready(function() {

            // SweetAlert2 Toast helper
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });

            // Helper function to re-render table dynamically with pagination, sorting, and multi-filter parameters
            function refreshTable(page = currentPage) {
                currentPage = page;

                var searchVal = $("#searchInput").val();
                var deptVal = $("#departmentFilter").val();
                var statusVal = $("#statusFilter").val();

                $.get("/Student/GetTablePartial", {
                    searchString: searchVal,
                    selectedDepartment: deptVal,
                    statusFilter: statusVal,
                    sortOrder: currentSort,
                    pageNumber: currentPage
                })
                    .done(function(data) {
                        $("#tableContainer").html(data);
                    })
                    .fail(function() {
                        console.error("Failed to refresh table container.");
                    });
            }

            // Helper function to safely re-bind validation dynamically
            function rebindValidation(formSelector) {
                if (window.jQuery && $.validator && $.validator.unobtrusive) {
                    var $form = $(formSelector);
                    if ($form.length > 0) {
                        $form.removeData("validator");
                        $form.removeData("unobtrusiveValidation");
                        $.validator.unobtrusive.parse(formSelector);
                    }
                }
            }

            // ==========================================
            // Pagination, Sorting & Multi-Filter Event Handlers
            // ==========================================

            // 1. AJAX Pagination click
            $(document).on("click", ".page-change", function(e) {
                e.preventDefault();
                var page = $(this).data("page");
                if (page) {
                    refreshTable(page);
                }
            });

            // 2. Dynamic Column Sorting click
            $(document).on("click", ".sort-link", function(e) {
                e.preventDefault();
                currentSort = $(this).data("sort");
                refreshTable(1); // Reset to page 1 on new sort direction
            });

            // 3. Search Form Submit
            $("#searchForm").on("submit", function(e) {
                e.preventDefault();
                refreshTable(1); // Reset to page 1 on new filter criteria
            });

            // 4. Instant Filter on Dropdown Selection Change
            $(document).on("change", "#departmentFilter, #statusFilter", function() {
                refreshTable(1);
            });

            // 5. Reset Button Click
            $("#btnReset").on("click", function() {
                $("#searchInput").val("");
                $("#departmentFilter").val("");
                $("#statusFilter").val("");
                currentSort = "";
                refreshTable(1);
            });

            // ==========================================
            // Modal & CRUD Operations (AJAX)
            // ==========================================

            // Open Create Modal
            $("#btnOpenCreateModal").click(function() {
                $("#studentModalLabel").text("Add New Student");

                $.get("/Student/CreatePartial")
                    .done(function(data) {
                        $("#modalBody").html(data);
                        rebindValidation("#createStudentForm");
                        $("#studentModal").modal("show");
                    })
                    .fail(function(xhr) {
                        Swal.fire('Error', 'Could not load Create view. Status: ' + xhr.status, 'error');
                    });
            });

            // Submit Create Form
            $(document).on("click", "#btnSaveStudent", function(e) {
                e.preventDefault();
                var $form = $("#createStudentForm");

                if ($form.length && $.validator && $.validator.unobtrusive) {
                    if (!$form.valid()) return false;
                }

                var formData = new FormData($form[0]);

                $.ajax({
                    url: "/Student/CreateAjax",
                    type: "POST",
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function(res) {
                        if (res.success) {
                            $("#studentModal").modal("hide");
                            Toast.fire({ icon: 'success', title: res.message || 'Student added successfully!' });
                            refreshTable(1); // Return to page 1 to highlight new entry
                        } else {
                            Swal.fire('Validation Error', res.message || 'Validation failed.', 'warning');
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Error', 'Server returned error ' + xhr.status, 'error');
                    }
                });
            });

            // Open Edit Modal
            $(document).on("click", ".btn-edit", function() {
                var studentId = $(this).data("id");
                $("#studentModalLabel").text("Edit Student");

                $.get("/Student/EditPartial/" + studentId)
                    .done(function(data) {
                        $("#modalBody").html(data);
                        rebindValidation("#editStudentForm");
                        $("#studentModal").modal("show");
                    })
                    .fail(function(xhr) {
                        Swal.fire('Error', 'Could not load Edit view for ID ' + studentId + '. Status: ' + xhr.status, 'error');
                    });
            });

            // Submit Edit Form
            $(document).on("click", "#btnUpdateStudent", function(e) {
                e.preventDefault();
                var $form = $("#editStudentForm");

                if ($form.length && $.validator && $.validator.unobtrusive) {
                    if (!$form.valid()) return false;
                }

                var formData = new FormData($form[0]);

                $.ajax({
                    url: "/Student/EditAjax",
                    type: "POST",
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function(res) {
                        if (res.success) {
                            $("#studentModal").modal("hide");
                            Toast.fire({ icon: 'success', title: res.message || 'Student updated successfully!' });
                            refreshTable(); // Refresh current page
                        } else {
                            Swal.fire('Error', res.message || 'Update failed.', 'error');
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Error', 'Server returned error ' + xhr.status, 'error');
                    }
                });
            });

            // Delete Student
            $(document).on("click", ".btn-delete", function() {
                var studentId = $(this).data("id");
                var token = $('input[name="__RequestVerificationToken"]').val();

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmColor: '#d33',
                    cancelColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/Student/DeleteAjax/" + studentId,
                            type: "POST",
                            headers: { "RequestVerificationToken": token },
                            success: function(res) {
                                if (res.success) {
                                    Toast.fire({ icon: 'success', title: res.message || 'Student deleted!' });
                                    refreshTable(); // Refresh current page
                                } else {
                                    Swal.fire('Error', res.message || 'Delete failed.', 'error');
                                }
                            },
                            error: function(xhr) {
                                Swal.fire('Error', 'Server returned error ' + xhr.status, 'error');
                            }
                        });
                    }
                });

                document.getElementById('btnExportPdf').addEventListener('click', function() {
                    // Read current values from your filter inputs/selects
                    const searchString = document.getElementById('searchStringInput')?.value || '';
                    const selectedDepartment = document.getElementById('departmentSelect')?.value || '';
                    const statusFilter = document.getElementById('statusSelect')?.value || '';
                    const sortOrder = document.getElementById('sortOrderHidden')?.value || '';

                    // Build query URL
                    const params = new URLSearchParams({
                        searchString: searchString,
                        selectedDepartment: selectedDepartment,
                        statusFilter: statusFilter,
                        sortOrder: sortOrder
                    });

                    // Trigger PDF Download
                    window.location.href = `@Url.Action("ExportPdf", "Student")?${params.toString()}`;
                });

            });

        });
    </script>
}


