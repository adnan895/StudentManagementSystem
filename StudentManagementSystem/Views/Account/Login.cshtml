                    </button>
                </form>

                <!-- Registration Redirect -->
                <div class="mt-4 text-center border-top border-secondary pt-3">
                    <a asp-action="Register" class="text-white-50 text-decoration-none small">
                        Don't have an account? <span class="text-info fw-semibold">Register here</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} *@



@model StudentManagementSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center align-items-center mt-4">
    <div class="col-md-5 col-lg-4">

        <!-- Default Seed Credentials Helper Box -->
        <div class="alert alert-info border-0 rounded-4 shadow-sm mb-4 text-white"
             style="background-color: #2b2b40; border-left: 5px solid #0dcaf0 !important;">
            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-info-circle-fill text-info fs-4 me-2"></i>
                <h6 class="fw-bold mb-0 text-white">Default Admin Credentials</h6>
            </div>
            <hr class="border-secondary opacity-25 my-2">
            <p class="mb-1 small"><strong>Email:</strong> <code class="text-info">admin@institution.edu</code></p>
            <p class="mb-0 small"><strong>Password:</strong> <code class="text-info">Admin123!</code></p>
        </div>

        <!-- Main Login Card -->
        <div class="card border-0 rounded-4 shadow-lg p-4" style="background-color: #2b2b40;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                     style="width: 50px; height: 50px; background: rgba(232, 62, 140, 0.15); color: #e83e8c;">
                    <i class="bi bi-lock-fill fs-3"></i>
                </div>
                <h4 class="fw-bold text-white mb-1">Account Login</h4>
                <p class="text-white-50 small mb-0">Sign in to access your portal dashboard</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-white-50 small fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1b1b28; color: #a1a5b7;">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control" placeholder="admin@institution.edu" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-white-50 small fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1b1b28; color: #a1a5b7;">
                            <i class="bi bi-key"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label text-white-50 small">Remember Me</label>
                </div>

                <button type="submit" class="btn w-100 fw-bold text-white py-2 mb-3 shadow"
                        style="background: linear-gradient(135deg, #e83e8c 0%, #c2185b 100%); border: none;">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>

                <div class="text-center">
                    <span class="text-white-50 small">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" class="text-info small fw-bold text-decoration-none ms-1">Register here</a>
                </div>
            </form>
        </div>

    </div>
</div>