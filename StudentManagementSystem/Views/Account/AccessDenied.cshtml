@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center mt-5 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 text-center" style="background-color: #2b2b40; color: #ffffff;">
            <!-- Warning Header -->
            <div class="card-header text-white text-center py-4 rounded-top-4"
                 style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                <i class="bi bi-shield-x display-4 d-block mb-2"></i>
                <h3 class="fw-bold mb-0">Access Denied</h3>
                <p class="small text-white-50 mb-0">Insufficient Role Permissions</p>
            </div>

            <div class="card-body p-4">
                <p class="lead text-light fw-semibold mb-2">
                    You do not have authorization to view this page.
                </p>

                <p class="text-white-50 small mb-4">
                    This section of the portal is restricted to specific institutional roles (Admin, Instructor, or Student). If you believe you should have access to this module, please contact your system administrator.
                </p>

                <!-- Navigation Actions -->
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn px-4 py-2 fw-bold text-white shadow-sm"
                       style="background: linear-gradient(135deg, #e83e8c 0%, #c2185b 100%); border: none;">
                        <i class="bi bi-house-door-fill me-1"></i> Return to Home
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-secondary px-3 py-2 fw-semibold text-light">
                            <i class="bi bi-box-arrow-right me-1"></i> Switch Account
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>