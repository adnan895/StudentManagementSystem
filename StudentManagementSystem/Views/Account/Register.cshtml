@model StudentManagementSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register Account";
}

<div class="row justify-content-center align-items-center mt-4 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4" style="background-color: #2b2b40; color: #ffffff;">
            <!-- Pink Gradient Header Accent -->
            <div class="card-header text-white text-center py-4 rounded-top-4"
                 style="background: linear-gradient(135deg, #e83e8c 0%, #c2185b 100%);">
                <i class="bi bi-person-plus-fill display-5 d-block mb-2"></i>
                <h4 class="fw-bold mb-0">Create an Account</h4>
                <p class="small text-white-50 mb-0">Register to access the Academic Portal</p>
            </div>

            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold text-light">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <input asp-for="FullName" class="form-control" placeholder="John Doe" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-light">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            <input asp-for="Email" class="form-control" placeholder="name@institution.edu" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-light">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="Password" class="form-control" placeholder="At least 6 characters" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold text-light">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn w-100 py-2 fw-bold text-white shadow-sm"
                            style="background: linear-gradient(135deg, #e83e8c 0%, #c2185b 100%); border: none;">
                        <i class="bi bi-person-check-fill me-1"></i> Register Account
                    </button>
                </form>

                <!-- Login Navigation Link -->
                <div class="mt-4 text-center border-top border-secondary pt-3">
                    <a asp-action="Login" class="text-white-50 text-decoration-none small">
                        Already have an account? <span class="text-info fw-semibold">Sign in here</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}