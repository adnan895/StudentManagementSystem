@using Microsoft.AspNetCore.Identity
@using StudentManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "System Overview";
}


<div class="container-fluid px-0">

    <!-- Hero Overview Banner -->
    <div class="card border-0 rounded-4 shadow-lg mb-5 text-white hero-overview-card">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-danger bg-opacity-20 text-white border border-danger border-opacity-20 px-3 py-2 rounded-pill mb-3">
                        <i class="bi bi-shield-lock-fill me-1"></i> Academic Management System
                    </span>
                    <h1 class="display-5 fw-bold mb-3">Institutional Information Portal</h1>
                    <p class="fs-6 text-white-50 mb-4 lh-base">
                        Comprehensive management solution for organizing departmental structures, faculty rosters, curriculum offerings, student records, and course grading workflows.
                    </p>

                    <!-- Authentication Controls Only -->
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-lg fw-bold text-white px-4 py-2 shadow-sm btn-pink-gradient">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-lg btn-outline-light px-4 py-2 fw-bold">
                                <i class="bi bi-person-plus-fill me-2"></i> Register Account
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center flex-wrap gap-3">
                            <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-20 px-3 py-2 rounded-pill fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i> Active Session: <strong>@User.Identity?.Name</strong>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm fw-bold px-3 py-2">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </div>
                    }
                </div>
                <div class="col-lg-4 text-center text-lg-end d-none d-lg-block">
                    <i class="bi bi-mortarboard display-1 text-white-50 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- System Module Details (Informational Only - No Action Links) -->
    <div class="mb-5">
        <div class="mb-4">
            <h4 class="fw-bold text-white mb-1">
                <i class="bi bi-diagram-3-fill text-danger me-2"></i>System Architecture Overview
            </h4>
            <p class="text-white-50 small mb-0">Detailed breakdown of organizational modules and relational hierarchy within the system.</p>
        </div>

        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3">
            <!-- 1. Departments -->
            <div class="col">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-info text-dark fw-bold">Step 01</span>
                        <i class="bi bi-building fs-3 text-info"></i>
                    </div>
                    <h5 class="fw-bold text-white">Departments</h5>
                    <p class="text-white-50 small mb-0">
                        Root institutional divisions (e.g., Computer Science, Mathematics) defining office locations and academic domains.
                    </p>
                </div>
            </div>

            <!-- 2. Instructors -->
            <div class="col">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning text-dark fw-bold">Step 02</span>
                        <i class="bi bi-person-badge fs-3 text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-white">Instructors</h5>
                    <p class="text-white-50 small mb-0">
                        Faculty profile tracking, hire dates, contact records, and parent department assignments.
                    </p>
                </div>
            </div>

            <!-- 3. Courses -->
            <div class="col">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge text-white fw-bold bg-pink">Step 03</span>
                        <i class="bi bi-journal-bookmark fs-3 text-pink"></i>
                    </div>
                    <h5 class="fw-bold text-white">Course Catalog</h5>
                    <p class="text-white-50 small mb-0">
                        Curriculum offerings containing credit hour calculations, course codes, and assigned primary instructors.
                    </p>
                </div>
            </div>

            <!-- 4. Students -->
            <div class="col">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-success fw-bold">Step 04</span>
                        <i class="bi bi-people fs-3 text-success"></i>
                    </div>
                    <h5 class="fw-bold text-white">Students</h5>
                    <p class="text-white-50 small mb-0">
                        Official directory of student profiles, enrollment dates, major declarations, and personal contact details.
                    </p>
                </div>
            </div>

            <!-- 5. Enrollments -->
            <div class="col">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-primary fw-bold">Step 05</span>
                        <i class="bi bi-journal-check fs-3 text-primary"></i>
                    </div>
                    <h5 class="fw-bold text-white">Enrollments</h5>
                    <p class="text-white-50 small mb-0">
                        Bridge mapping students to courses, grade recording (A–F), and cumulative transcript calculations.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Role Access & Privileges Specification -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 icon-box icon-box-danger">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-0">Admin Privileges</h5>
                </div>
                <ul class="list-unstyled text-white-50 small mb-0">
                    <li class="mb-2"><i class="bi bi-dot text-danger fs-4 align-middle me-1"></i>Full CRUD control on Departments & Instructors.</li>
                    <li class="mb-2"><i class="bi bi-dot text-danger fs-4 align-middle me-1"></i>Manage course catalog and instructor allocations.</li>
                    <li class="mb-0"><i class="bi bi-dot text-danger fs-4 align-middle me-1"></i>Register students and oversee all enrollments.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 icon-box icon-box-warning">
                        <i class="bi bi-person-workspace fs-5"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-0">Faculty Privileges</h5>
                </div>
                <ul class="list-unstyled text-white-50 small mb-0">
                    <li class="mb-2"><i class="bi bi-dot text-warning fs-4 align-middle me-1"></i>View assigned active course catalog items.</li>
                    <li class="mb-2"><i class="bi bi-dot text-warning fs-4 align-middle me-1"></i>Access enrolled student class rosters.</li>
                    <li class="mb-0"><i class="bi bi-dot text-warning fs-4 align-middle me-1"></i>Assign and update letter grades for students.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 icon-box icon-box-success">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-0">Student Privileges</h5>
                </div>
                <ul class="list-unstyled text-white-50 small mb-0">
                    <li class="mb-2"><i class="bi bi-dot text-success fs-4 align-middle me-1"></i>View personal enrollment history.</li>
                    <li class="mb-2"><i class="bi bi-dot text-success fs-4 align-middle me-1"></i>Inspect active course grades and credits earned.</li>
                    <li class="mb-0"><i class="bi bi-dot text-success fs-4 align-middle me-1"></i>Access official academic transcript summaries.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Footer Authentication Reminder -->
    @if (!SignInManager.IsSignedIn(User))
    {
        <div class="card border-0 rounded-4 p-4 text-center bg-dark-purple">
            <p class="text-white-50 mb-3">Please authenticate with your credentials to unlock management features in the top navigation bar.</p>
            <div>
                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light px-4 py-2 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Proceed to Login
                </a>
            </div>
        </div>
    }

</div>