@model IEnumerable<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Course Catalog";
}

<div class="container mt-4">
    <!-- Header & Action Buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Course Catalog</h2>

        <div class="d-flex align-items-center gap-2">
            <a asp-action="ExportPdf" target="_blank" class="btn btn-outline-danger">
                <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF Report
            </a>

            @if (User.IsInRole("Admin") || User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add New Course
                </a>
            }
        </div>
    </div>

    <!-- Course Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Course Title</th>
                        <th>Credits</th>
                        <th>Department</th>
                        <th>Instructor</th>
                        <th>Enrolled</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No courses created yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-dark">@item.CourseCode</span></td>
                                <td class="fw-bold">@item.Title</td>
                                <td>@item.Credits Cr.</td>
                                <td><span class="badge bg-secondary">@item.Department</span></td>
                                <td>
                                    @(item.Instructor != null ? item.Instructor.Name : "Unassigned")
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @(item.Enrollments?.Count ?? 0) Students
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> View Roster
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>