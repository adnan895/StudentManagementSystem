@model IEnumerable<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Course Catalog";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Course Catalog</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Course
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Course Title</th>
                        <th>Credits</th>
                        <th>Department</th>
                        <th>Instructor</th>
                        <th>Enrolled</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No courses created yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-dark">@item.CourseCode</span></td>
                                <td class="fw-bold">@item.Title</td>
                                <td>@item.Credits Cr.</td>
                                <td><span class="badge bg-secondary">@item.Department</span></td>
                                <td>
                                    @(item.Instructor != null ? item.Instructor.Name : "Unassigned")
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.Enrollments.Count Students
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View Roster
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>