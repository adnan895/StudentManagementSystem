@model StudentManagementSystem.Models.Course

@{
    ViewData["Title"] = "Course Details & Roster";
    var availableStudents = ViewBag.AvailableStudents as IEnumerable<StudentManagementSystem.Models.Student>;
}

<div class="container mt-4">

    <!-- Header Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Courses
        </a>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#enrollModal">
            <i class="bi bi-person-plus-fill me-1"></i> Enroll Student
        </button>
    </div>

    <!-- Course Info Header Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-dark mb-2 fs-6">@Model.CourseCode</span>
                    <h2 class="mb-1">@Model.Title</h2>
                    <p class="text-muted mb-0">
                        <strong>Department:</strong> <span class="badge bg-secondary">@Model.Department</span> |
                        <strong>Credits:</strong> @Model.Credits Cr.
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="p-3 bg-light rounded border">
                        <small class="text-muted d-block fw-bold">Assigned Instructor</small>
                        <span class="fs-5 fw-semibold text-primary">
                            <i class="bi bi-person-workspace me-1"></i>
                            @(Model.Instructor != null ? Model.Instructor.Name : "Unassigned")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enrolled Students Roster Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Enrolled Students Roster</h5>
            <span class="badge bg-primary fs-6">@Model.Enrollments.Count Enrolled</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Student Name</th>
                        <th>Email</th>
                        <th style="width: 200px;">Assign Grade</th>
                        <th class="text-end" style="width: 120px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Enrollments.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No students are currently enrolled in this course.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var enrollment in Model.Enrollments)
                        {
                            <tr>
                                <td>@enrollment.Student?.Id</td>

                                <!-- Combines FirstName and LastName -->
                                <td class="fw-bold">
                                    @if (enrollment.Student != null)
                                    {
                                        @($"{enrollment.Student.FirstName} {enrollment.Student.LastName}".Trim())
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>

                                <td>@enrollment.Student?.Email</td>
                                <td>
                                    <!-- Dynamic Inline Grade Dropdown -->
                                    <select class="form-select form-select-sm grade-select" data-enrollment-id="@enrollment.Id">
                                        @foreach (var grade in Enum.GetValues(typeof(StudentManagementSystem.Models.Grade)))
                                        {
                                            <option value="@grade" selected="@(enrollment.Grade.ToString() == grade.ToString() ? "selected" : null)">
                                                @grade
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove-enrollment" data-id="@enrollment.Id">
                                        <i class="bi bi-trash"></i> Drop
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Anti-Forgery Token -->
@Html.AntiForgeryToken()

<!-- Enroll Student Modal Shell -->
<div class="modal fade" id="enrollModal" tabindex="-1" aria-labelledby="enrollModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="enrollModalLabel">
                    <i class="bi bi-person-plus me-1"></i> Enroll Student in @Model.CourseCode
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (availableStudents != null && availableStudents.Any())
                {
                    <form id="enrollForm">
                        <input type="hidden" id="courseId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-bold">Select Student (@Model.Department Dept)</label>
                            <select id="studentSelect" class="form-select" required>
                                <option value="">-- Choose Unenrolled Student --</option>
                                @foreach (var student in availableStudents)
                                {
                                    <option value="@student.Id">
                                        @($"{student.FirstName} {student.LastName}".Trim()) (@student.Email)
                                    </option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Confirm Enrollment</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-1"></i> No unassigned <strong>@Model.Department</strong> students available for enrollment.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const token = $('input[name="__RequestVerificationToken"]').val();

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500,
                timerProgressBar: true
            });

            // 1. Submit Student Enrollment
            $("#enrollForm").on("submit", function(e) {
                e.preventDefault();
                var courseId = $("#courseId").val();
                var studentId = $("#studentSelect").val();

                if (!studentId) return;

                $.ajax({
                    url: "/Course/EnrollStudentAjax",
                    type: "POST",
                    headers: { "RequestVerificationToken": token },
                    data: { courseId: courseId, studentId: studentId },
                    success: function(res) {
                        if (res.success) {
                            $("#enrollModal").modal("hide");
                            Toast.fire({ icon: 'success', title: res.message });
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            Swal.fire('Error', res.message, 'warning');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Server processing error occurred.', 'error');
                    }
                });
            });

            // 2. Change Grade Inline
            $(document).on("change", ".grade-select", function() {
                var enrollmentId = $(this).data("enrollment-id");
                var selectedGrade = $(this).val();

                $.ajax({
                    url: "/Course/UpdateGradeAjax",
                    type: "POST",
                    headers: { "RequestVerificationToken": token },
                    data: { enrollmentId: enrollmentId, grade: selectedGrade },
                    success: function(res) {
                        if (res.success) {
                            Toast.fire({ icon: 'success', title: res.message });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Failed to update grade.', 'error');
                    }
                });
            });

            // 3. Drop Student Enrollment
            $(document).on("click", ".btn-remove-enrollment", function() {
                var enrollmentId = $(this).data("id");

                Swal.fire({
                    title: 'Drop Student?',
                    text: "This student will be removed from the course roster.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmColor: '#d33',
                    cancelColor: '#3085d6',
                    confirmButtonText: 'Yes, drop student'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/Course/RemoveEnrollmentAjax",
                            type: "POST",
                            headers: { "RequestVerificationToken": token },
                            data: { enrollmentId: enrollmentId },
                            success: function(res) {
                                if (res.success) {
                                    Toast.fire({ icon: 'success', title: res.message });
                                    setTimeout(() => location.reload(), 1000);
                                } else {
                                    Swal.fire('Error', res.message, 'error');
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}