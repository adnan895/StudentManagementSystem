@model IEnumerable<string>

@{
    ViewData["Title"] = "Departments";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-building me-2 text-primary"></i>Department Directory
            </h2>
            <p class="text-muted small mb-0">List of all active academic departments pulled from student records.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Department Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4" style="width: 10%;">#</th>
                            <th style="width: 60%;">Department Name</th>
                            <th style="width: 30%;">Quick Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var dept in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-bold">@index</td>
                                    <td>
                                        <span class="fw-bold text-dark">@dept</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Student"
                                           asp-action="Index"
                                           asp-route-selectedDepartment="@dept"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-funnel me-1"></i> Filter Students
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    No active departments found in student records.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>