@using Microsoft.AspNetCore.Identity
@using StudentManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentManagementSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentManagementSystem.styles.css" asp-append-version="true" />

    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/site.css" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Global Dark Theme Body Styling -->
    <style>
            body {
                background-color: saddlebrown !important;
                color: #e4e6ef !important;
                min-height: 100vh;
            }

            .card {
                background-color: #2b2b40 !important;
                color: #ffffff !important;
                border: 1px solid #323248 !important;
            }

            .table {
                color: #e4e6ef !important;
            }

            .table-light {
                background-color: #323248 !important;
                color: #ffffff !important;
            }

            .form-control, .form-select {
                background-color: #1b1b28 !important;
                border-color: #323248 !important;
                color: #ffffff !important;
            }
    </style>
</head>
<body>
    <header>
        <!-- Pink Gradient Header -->
        <nav class="navbar navbar-expand-lg navbar-dark shadow mb-4"
             style="background: linear-gradient(135deg, black 0%, black 100%);">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white fs-5" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2"></i>StudentManagementSystem
                </a>
                <button class="navbar-toggler border-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav flex-grow-1 ms-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i> Home
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Department" asp-action="Index">
                                        <i class="bi bi-building me-1"></i> Departments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Instructor" asp-action="Index">
                                        <i class="bi bi-person-badge-fill me-1"></i> Instructors
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Course" asp-action="Index">
                                        <i class="bi bi-journal-bookmark-fill me-1"></i> Courses
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Student" asp-action="Index">
                                        <i class="bi bi-people-fill me-1"></i> Students
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Enrollment" asp-action="Index">
                                        <i class="bi bi-journal-check me-1"></i> Enrollments
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Instructor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Course" asp-action="Index">
                                        <i class="bi bi-journal-bookmark-fill me-1"></i> My Courses
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Enrollment" asp-action="Index">
                                        <i class="bi bi-journal-check me-1"></i> Assign Grades
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold px-3" asp-controller="Enrollment" asp-action="Index">
                                        <i class="bi bi-journal-check me-1"></i> My Enrollments & Grades
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- User Account / Login Controls -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <span class="badge bg-white text-dark px-3 py-2 fw-bold rounded-pill">
                                    <i class="bi bi-person-circle text-primary me-1"></i> @User.Identity?.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light fw-bold px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-light text-primary fw-bold px-3 shadow-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <br />

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <br />
    <br />
    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container text-center">
            &copy; 2026 - StudentManagementSystem - <a asp-controller="Home" asp-action="Privacy" class="text-white-50">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>