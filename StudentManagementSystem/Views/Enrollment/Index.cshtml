@model IEnumerable<StudentManagementSystem.Models.Enrollment>

@{
    ViewData["Title"] = "Student Enrollments";
}

<div class="container mt-4">
    <!-- Header & Trigger Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-journal-check text-primary me-2"></i>Course Enrollments & Grading
        </h3>
        <button type="button" class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#enrollStudentModal">
            <i class="bi bi-plus-circle me-1"></i> Enroll Student
        </button>
    </div>

    <!-- Enrollments Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Course</th>
                        <th>Grade</th>
                        <th>Assign Grade</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No active course enrollments found. Click <strong>Enroll Student</strong> above to register a student into a course.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Student?.FirstName @item.Student?.LastName</td>
                                <td>@item.Course?.Title</td>
                                <td>
                                    @if (item.Grade.HasValue)
                                    {
                                        <span class="badge bg-success fs-6">@item.Grade</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pending</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="AssignGrade" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="enrollmentId" value="@item.Id" />
                                        <select name="grade" class="form-select form-select-sm" style="width: 110px;" required>
                                            <option value="">Select...</option>
                                            <option value="A">A</option>
                                            <option value="B">B</option>
                                            <option value="C">C</option>
                                            <option value="D">D</option>
                                            <option value="F">F</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <form asp-action="DropStudent" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Drop this student from course?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Drop</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quick Enrollment Modal -->
<div class="modal fade" id="enrollStudentModal" tabindex="-1" aria-labelledby="enrollStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="enrollStudentModalLabel">
                    <i class="bi bi-person-plus-fill me-2"></i>Quick Course Enrollment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EnrollStudent" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Student</label>
                        <select name="studentId" class="form-select" asp-items="ViewBag.StudentId" required>
                            <option value="">-- Choose Student --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Course</label>
                        <select name="courseId" class="form-select" asp-items="ViewBag.CourseId" required>
                            <option value="">-- Choose Course --</option>
                        </select>
                    </div>

                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-check-circle me-1"></i> Confirm Enrollment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>